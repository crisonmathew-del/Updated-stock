# Copy to .env and fill in what you have. Every key is optional in development: the defaults
# use free, keyless sources (yfinance for dev prices, SEC EDGAR for fundamentals).
# Secrets are only ever read by the backend; the browser never sees them.

# --- Runtime ---------------------------------------------------------------------------------
APP_ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console (console is easier to read locally)
MARKET_TIMEZONE=America/New_York
PATTERN_WORKERS=0                 # processes for pattern detection: 0 = CPU cores - 1, 1 = none
BACKTEST_DIR=var/backtests        # backtest tape cache (relative to the API's directory)

# --- Infrastructure --------------------------------------------------------------------------
# These addresses are for running the API on your host. Inside Docker Compose they are
# overridden with the container-network addresses automatically.
DATABASE_URL=postgresql+asyncpg://breakout:breakout@localhost:5432/breakout
REDIS_URL=redis://localhost:6379/0
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Provider selection ----------------------------------------------------------------------
PRICE_PROVIDER=yfinance           # yfinance (dev only) | massive
STREAM_PROVIDER=none              # none | alpaca | replay
FUNDAMENTALS_PROVIDER=sec_edgar   # sec_edgar | fmp
NEWS_PROVIDER=none                # none | finnhub

# --- Market data -----------------------------------------------------------------------------
MASSIVE_API_KEY=                  # Massive (formerly Polygon.io)
MASSIVE_BASE_URL=https://api.massive.com
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex                   # iex (free, partial volume) | sip (paid, full volume)
# Replay mode (STREAM_PROVIDER=replay): play a recorded session back as the live feed.
REPLAY_FILE=                      # e.g. recordings/2026-10-02.csv.gz (CSV of minute bars)
REPLAY_SPEED=60                   # × real time; 0 = as fast as possible
REPLAY_START=                     # HH:MM US/Eastern to skip ahead to, e.g. 09:25
REPLAY_CLOSE=true                 # at the end, store the day's bars and confirm/reject breakouts
FMP_API_KEY=                      # Financial Modeling Prep
FINNHUB_API_KEY=
# Needed for company IDs, industry codes and market caps from SEC EDGAR (free, no key). SEC
# requires a descriptive User-Agent with contact details, e.g. "Breakout you@example.com".
SEC_USER_AGENT=

# --- AI summaries (optional) -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Notifications ---------------------------------------------------------------------------
PUBLIC_URL=http://localhost:3000  # where alert links point
EMAIL_PROVIDER=resend             # resend | smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls            # starttls | ssl | none
EMAIL_FROM=                       # e.g. "Breakout <alerts@yourdomain.com>"
EMAIL_TO=                         # defaults to your login email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Host ports for `make dev` (change if something else already uses them) -------------------
# WEB_PORT=3000
# API_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
