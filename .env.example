# Copy to .env and fill in what you have. Every key is optional in development: the defaults
# use free, keyless sources (yfinance for dev prices, SEC EDGAR for fundamentals).
# Secrets are only ever read by the backend; the browser never sees them.
# Put a note for an empty value on the line above it: Docker Compose reads `KEY=   # note` as the
# value "# note" (after a value, `KEY=value   # note` is fine).

# --- Runtime ---------------------------------------------------------------------------------
APP_ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console (console is easier to read locally)
MARKET_TIMEZONE=America/New_York
PATTERN_WORKERS=0                 # processes for pattern detection: 0 = CPU cores - 1, 1 = none
BACKTEST_DIR=var/backtests        # backtest tape cache (relative to the API's directory)

# --- Infrastructure --------------------------------------------------------------------------
# These addresses are for running the API on your host. Inside Docker Compose they are
# overridden with the container-network addresses automatically.
DATABASE_URL=postgresql+asyncpg://breakout:breakout@localhost:5432/breakout
REDIS_URL=redis://localhost:6379/0
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Provider selection ----------------------------------------------------------------------
PRICE_PROVIDER=yfinance           # yfinance (dev only) | massive
STREAM_PROVIDER=none              # none | alpaca | replay
FUNDAMENTALS_PROVIDER=sec_edgar   # sec_edgar | fmp
NEWS_PROVIDER=none                # none | finnhub

# --- Market data -----------------------------------------------------------------------------
# Massive (formerly Polygon.io)
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex                   # iex (free, partial volume) | sip (paid, full volume)
# Replay mode (STREAM_PROVIDER=replay): play a recorded session back as the live feed.
# The recording to play, e.g. recordings/2026-10-02.csv.gz (CSV of minute bars).
REPLAY_FILE=
REPLAY_SPEED=60                   # × real time; 0 = as fast as possible
# HH:MM US/Eastern to skip ahead to, e.g. 09:25.
REPLAY_START=
REPLAY_CLOSE=true                 # at the end, store the day's bars and confirm/reject breakouts
# Financial Modeling Prep
FMP_API_KEY=
FINNHUB_API_KEY=
# Needed for company IDs, industry codes and market caps from SEC EDGAR (free, no key). SEC
# requires a descriptive User-Agent with contact details, e.g. "Breakout you@example.com".
SEC_USER_AGENT=

# --- AI summaries (optional) -----------------------------------------------------------------
# The stock page's "Summarise" button stays off until a key is set. Default model: claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Notifications ---------------------------------------------------------------------------
PUBLIC_URL=http://localhost:3000  # where alert links point
EMAIL_PROVIDER=resend             # resend | smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls            # starttls | ssl | none
# Sender, e.g. "Breakout <alerts@yourdomain.com>"; recipient (defaults to your login email).
EMAIL_FROM=
EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Production (`make deploy` on the server; see docs/deploy.md) -----------------------------
# Keep SESSION_SECRET (above) set. The production compose file sets APP_ENV=prod, the database
# and Redis addresses, PUBLIC_URL=https://DOMAIN and BACKTEST_DIR itself.
# The server's public name (a DNS A/AAAA record pointing at the server) and the address Let's
# Encrypt writes to about certificate problems. DOMAIN=localhost tests the stack on your machine
# with a certificate from Caddy's own local CA.
DOMAIN=
ACME_EMAIL=
# Database password: letters and digits only (it goes into a URL). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# HTTP_PORT=80
# HTTPS_PORT=443
# Nightly backups at BACKUP_TIME US/Eastern; how many daily and weekly (Sunday) dumps to keep.
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# The status page fails the backup row when the last backup is older than this.
# BACKUP_MAX_AGE_HOURS=26
# Optional off-site copy to S3-compatible storage (AWS S3, Backblaze B2, Cloudflare R2, Wasabi…):
# the backup folder is mirrored to s3://BACKUP_S3_BUCKET/BACKUP_S3_PREFIX after each dump.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=breakout
# Endpoint, e.g. https://<account>.r2.cloudflarestorage.com (empty for AWS), and region
# (e.g. us-east-1 on AWS).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_PROVIDER=Other          # rclone's provider name: AWS, Cloudflare, Wasabi, Other, ...
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Host ports for `make dev` (change if something else already uses them) -------------------
# WEB_PORT=3000
# API_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
